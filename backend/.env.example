# Application Settings
PROJECT_NAME="FastAPI RBAC & User Management API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
HOST=0.0.0.0
PORT=8000

# Security Settings (MUST BE CHANGED IN PRODUCTION)
